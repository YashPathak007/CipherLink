# Local development template only. Copy to .env and replace the placeholders.
# Never commit .env or reuse local values in a production deployment.

DATABASE_URL=postgres://your-user:your-password@localhost:5432/your-database
JWT_SECRET=replace-with-a-random-development-secret
MASTER_KEY_HEX=replace-with-64-lowercase-hex-characters
CORS_ORIGIN=http://localhost:5173
PORT=4000
STORAGE_DIR=./private-storage
MAX_FILE_SIZE=10485760
DEMO_PASSWORD=choose-a-local-demo-password
